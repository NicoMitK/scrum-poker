{
  "name": "Scrum Poker",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Scrum Poker",
      "onAutoForward": "openPreview"
    }
  },
  "postAttachCommand": "python server.py --port 8000",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
